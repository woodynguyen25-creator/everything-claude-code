  "scanSchedule": {
    "cron": "0 23 * * *",
    "timezone": "America/Chicago",
    "description": "Nightly at 11pm CDT — Sauron scans all watch categories and produces a digest by 11:15pm"
  },
  "categories": {
    "trading": {
      "label": "Markets + macro + geopolitical",

      "watchlistTickers": [
        "SPY", "QQQ", "IWM", "DIA",
        "NVDA", "AAPL", "MSFT", "GOOGL", "META", "TSLA", "AMZN",
        "AMD", "AVGO", "PLTR", "COIN"
      ],
      "sources": [
        { "name": "Bloomberg Markets RSS", "url": "https://feeds.bloomberg.com/markets/news.rss", "type": "rss" },
        { "name": "Reuters Business", "url": "https://www.reuters.com/business/", "type": "scrape" },
        { "name": "Financial Times Markets", "url": "https://www.ft.com/markets", "type": "scrape" },
        { "name": "ZeroHedge", "url": "https://www.zerohedge.com/", "type": "scrape", "note": "doom bias, weight signals lower but check for early macro turns" },
        { "name": "TradingView ideas (top stocks)", "url": "https://www.tradingview.com/ideas/", "type": "exa" },
        { "name": "Earnings calendar (TipRanks)", "url": "https://www.tipranks.com/calendars/earnings", "type": "scrape" },
        { "name": "FOMC + Fed speakers calendar", "url": "https://www.federalreserve.gov/newsevents/calendar.htm", "type": "scrape" },
        { "name": "Economic calendar (ForexFactory)", "url": "https://www.forexfactory.com/calendar", "type": "scrape" },
        { "name": "X/Twitter financial accounts via exa", "query": "@unusual_whales OR @zerohedge OR @DeItaone OR @LiveSquawk last 24h", "type": "exa" }

    "dfs": {
      "label": "DFS / sports betting prep",
      "weight": "tertiary",
      "description": "Game-day prep for Perseus + ParlayBot. Only fires when active sports seasons + tomorrow has games.",
      "sources": [
        { "name": "Rotowire injury report", "url": "https://www.rotowire.com/baseball/news.php", "type": "scrape" },
        { "name": "FantasyLabs", "url": "https://www.fantasylabs.com/", "type": "scrape" },

  },
  "deliveryRules": {
    "highPriority": {
      "description": "Findings that trigger immediate Telegram digest",
      "criteria": [
        "marketMove > 1% overnight",
        "watchlist ticker with >3% pre-market move",
        "any geopolitical escalation keyword",
        "new model release from Anthropic / OpenAI / DeepSeek / Google",
        "DFS late scratch on a player you have lineup exposure to"
      ]
    },
    "mediumPriority": {
      "description": "Findings included in nightly digest, no immediate ping",
      "criteria": [
        "Hacker News AI top stories",
        "ArXiv submissions matching interestKeywords",
        "competitive intel discovery (new dashboard / new framework)",
        "DFS lineup changes (non-critical)"
      ]
    },
    "lowPriority": {
      "description": "Logged to Obsidian's Sauron's Watch archive, never pinged",
      "criteria": [
        "general market commentary",
        "duplicate stories",
        "stale news (>48h old)"
      ]
    }
  },
  "digestFormat": {
    "obsidianPath": "Obsidian Vault/Sauron's Watch/{YYYY-MM-DD}.md",
    "telegramTrigger": "send only if at least one high-priority finding",
    "structure": "ranked list per category, source-cited, 2-3 sentence summary per finding, max 200 words total"
  }
}

      "geopoliticalKeywords": [
        "Fed", "FOMC", "CPI", "PPI", "NFP", "unemployment", "rate decision", "rate hike", "rate cut",
        "China tariff", "Taiwan", "Ukraine", "Russia sanctions", "Iran", "OPEC", "oil supply",
        "war", "conflict", "election", "treasury yield", "dollar strength"
      ],
      "scanDepth": "deep",
      "triggerThresholds": {
        "marketMove": "any S&P futures move >1% overnight triggers a high-priority finding",
        "ticker": "any watchlist ticker with >3% pre-market move or breaking news triggers high-priority",
        "macro": "any Fed action, CPI surprise, or geopolitical escalation triggers high-priority"
